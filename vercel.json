{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate.py": {
      "maxDuration": 60,
      "excludeFiles": "{weights_pretrained_*.npz,checkpoint_pretrained.pt,*.pt,sft_*.log,eval_*.txt}"
    },
    "api/bead_pattern.py": {
      "maxDuration": 30,
      "excludeFiles": "{weights_pretrained_*.npz,checkpoint_pretrained.pt,*.pt,sft_*.log,eval_*.txt}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/NEXUX.html" },
    { "source": "/api/quota", "destination": "/api/generate" },
    { "source": "/api/roles", "destination": "/api/generate" }
  ],
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  }
}
