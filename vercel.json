{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate.py": {
      "maxDuration": 60
    },
    "api/bead_pattern.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/NEXUX.html" },
    { "source": "/api/quota", "destination": "/api/generate" }
  ],
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  }
}
